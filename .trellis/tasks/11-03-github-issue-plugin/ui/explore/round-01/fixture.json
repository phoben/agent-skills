    "task": {
      "title": "修复仓库切换后的评论筛选",
      "status": "已确认关联",
      "action": "返回会话"
    },
    "bodyLead": "在仓库之间切换后，Issue 详情中的评论列表仍沿用上一个仓库的筛选条件，导致部分讨论没有显示。",
    "steps": [
      "打开 issue-hub，进入一条有评论的 Issue。",
      "切换到 platform-api，再返回当前 Issue。",
      "评论列表仍保留之前的筛选，而标题与属性已更新。"
    ],
    "expectation": "仓库切换应重置评论查询范围，同时保留尚未发布的输入。",
    "acceptance": [
      "评论只来自当前仓库与 Issue。",
      "切换期间迟到的响应不覆盖新页面。",
      "本机草稿与当前账号保持隔离。"
    ],
    "commentsLabel": "讨论 · 8",
    "previewComments": [
      {
        "author": "林舟",
        "initials": "林",
        "time": "18 分钟前",
        "text": "已复现。会补上切换时的请求失效处理，并验证返回列表后的位置保留。"
      },
      {
        "author": "陈雨",
        "initials": "陈",
        "time": "8 分钟前",
        "text": "也请覆盖切换前已经输入评论的情况，失败时不要清空内容。"
      }
    ],
